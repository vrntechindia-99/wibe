# Database
DATABASE_URL="postgresql://wibe:wibe_password@localhost:5432/wibe?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# Object Storage (MinIO for development)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="wibe-media"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:9000"

# WebSocket
WS_PORT=3001
WS_CORS_ORIGIN="http://localhost:3000"

# Application
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# Development Mode (enables mock OTP)
DEV_MODE="true"
DEV_OTP_CODE="123456"

# OTP/SMS Provider (configure for production)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SERVICE_SID=""

# Push Notifications (configure for production)
# FCM_SERVER_KEY=""
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_PRIVATE_KEY=""
# APNS_BUNDLE_ID=""

# TURN/STUN Server (coturn)
TURN_URL="turn:localhost:3478"
TURN_USERNAME="wibe"
TURN_PASSWORD="wibe_turn_password"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="debug"
LOG_PRETTY="true"

# Security
BCRYPT_ROUNDS=12